PORT=4000
DATABASE_URL=postgres://beinghuman:beinghuman@localhost:5432/beinghuman
# Comma-separated origins allowed to call the API (the Next.js app)
CORS_ORIGIN=http://localhost:3000
# Where uploaded photos and voice notes are written
STORAGE_DIR=./storage
# Prefix for media URLs; empty = relative /media/... (served through the Next.js proxy)
PUBLIC_URL=
# "Today" rotates at midnight in this zone
TZ_DAILY=Asia/Bangkok
