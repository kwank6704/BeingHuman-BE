PORT=4000
# On Vercel: the pooled Neon/Postgres URL (with ?sslmode=require)
DATABASE_URL=postgres://beinghuman:beinghuman@localhost:5432/beinghuman
# Comma-separated origins allowed to call the API directly (the frontend normally proxies, so this rarely matters)
CORS_ORIGIN=http://localhost:3000
# Local uploads dir (ignored when BLOB_READ_WRITE_TOKEN is set)
STORAGE_DIR=./storage
# Set on Vercel (added automatically when you connect a Blob store) to store uploads in Vercel Blob
BLOB_READ_WRITE_TOKEN=
# Prefix for local media URLs; empty = relative /media/... (served through the frontend proxy)
PUBLIC_URL=
# "Today" rotates at midnight in this zone
TZ_DAILY=Asia/Bangkok
# LINE Login channel ID (LINE Developers → the channel that owns the LIFF app). Empty = no LINE login;
# users are identified by the X-User-Id header (device id), fine for local development.
LINE_CHANNEL_ID=
# With LINE_CHANNEL_ID set, also accept X-User-Id (e.g. to keep showing the "demo" book). Leave false in production.
ALLOW_DEVICE_IDS=false
# ── 07:00 morning message from the LINE Official Account (/api/cron/morning, scheduled in vercel.json) ──
# Messaging API channel access token (LINE Developers → the OA's Messaging API channel → long-lived token). Empty = off.
LINE_MESSAGING_TOKEN=
# LIFF app the message's button opens (same as the frontend's NEXT_PUBLIC_LIFF_ID)
LIFF_ID=
# Deployed frontend URL, so photo links in the message are full https URLs
APP_URL=
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
